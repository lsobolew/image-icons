# Environment artefacts
.wplab/
env/docker-compose.gen.yml
env/docker-compose.override.yml
dist/
playwright-report/
test-results/

# Dependencies
node_modules/
vendor/

# Build output
plugins/*/build/
plugins/*/languages/*.mo
# The translation template is generated into the package by `wpx build`, from the staged copy of
# the plugin. Committing one would be committing a snapshot that goes stale the moment a string
# changes, and nobody would be able to tell by looking at it.
plugins/*/languages/*.pot
.phpunit.result.cache
.phpcs.cache

# The agent skills in .claude/skills are committed on purpose: everyone (and every agent)
# working on this repo should get the same WordPress instructions, and updates show up in diffs.

# System
.DS_Store
*.log
