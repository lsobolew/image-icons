{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "masked-icon/icon",
	"version": "0.1.0",
	"title": "Masked Icon",
	"category": "media",
	"icon": "art",
	"description": "Render any image as a single-colour icon that follows the text colour.",
	"keywords": [ "icon", "mask", "svg", "arrow" ],
	"textdomain": "masked-icon",
	"attributes": {
		"url": { "type": "string", "default": "" },
		"mediaId": { "type": "number", "default": 0 },
		"label": { "type": "string", "default": "" },
		"size": { "type": "string", "default": "1em" },
		"fit": { "type": "string", "default": "contain" },
		"verticalAlign": { "type": "string", "default": "middle" },
		"href": { "type": "string", "default": "" },
		"linkTarget": { "type": "string", "default": "" },
		"rel": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"color": {
			"text": true,
			"background": false,
			"gradients": false
		},
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
