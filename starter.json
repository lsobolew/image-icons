{
	"$schema": "./docs/starter.schema.json",
	"name": "Image Icons",
	"slug": "image-icons",
	"namespace": "Sobolewski\\ImageIcons",
	"constantPrefix": "IMAGE_ICONS",
	"hookPrefix": "imageicons",
	"textDomain": "image-icons",
	"description": "Turn any image into a colorable icon: PNG, SVG or WebP rendered as a CSS mask that inherits the text colour.",
	"author": "Lukasz Sobolewski",
	"authorUri": "https://github.com/lsobolew",
	"pluginUri": "https://github.com/lsobolew/image-icons",
	"license": "GPL-2.0-or-later",
	"requiresWp": "6.6",
	"requiresPhp": "7.4",
	"editions": {
		"free": {
			"dir": "image-icons",
			"enabled": true,
			"wporg": true
		},
		"pro": {
			"dir": "image-icons-pro",
			"enabled": false,
			"wporg": false
		}
	},
	"features": {
		"settings": {
			"enabled": false,
			"edition": "free"
		},
		"rest": {
			"enabled": false,
			"edition": "free"
		},
		"cli": {
			"enabled": false,
			"edition": "free"
		},
		"content-type": {
			"enabled": false,
			"edition": "free"
		},
		"blocks": {
			"enabled": true,
			"edition": "free"
		}
	},
	"skills": {
		"//": "Official WordPress agent skills (https://github.com/WordPress/agent-skills, GPL-2.0-or-later). Managed by `./bin/wpx skills`; an empty install list means every skill.",
		"repo": "https://github.com/WordPress/agent-skills.git",
		"ref": "trunk",
		"targets": [
			"claude"
		],
		"install": [
			"wordpress-router",
			"wp-plugin-development",
			"wp-plugin-directory-guidelines",
			"wp-block-development",
			"wp-rest-api",
			"wp-wpcli-and-ops",
			"wp-phpstan",
			"wp-performance"
		]
	},
	"lab": {
		"//": "Where `./bin/wpx upgrade` pulls the lab infrastructure from. Point it at your own starter repository.",
		"repo": "https://github.com/lsobolew/wp-plugin-lab.git",
		"ref": ""
	}
}
